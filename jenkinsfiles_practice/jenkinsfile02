        pipeline {
                agent any
                          stages {
                              stage('Checkout') {
                                steps {
                                checkout scm
                                       }
                                   }
                              stage('Build') {
                                steps {
                                  sh 'mvn clean package'
                  
                              }
                              stage('Test') {
                                steps {
                                 sh 'mvn test'
                                }
                              }
                              stage('Archive') {
                                steps {
                                  sh 'archiveArtifacts artifacts: '**/target/*.jar''
                                }
                              }
                          }
                      }
        }