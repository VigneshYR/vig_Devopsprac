 groovy
        pipeline {
                agent any stages {
                            stage('Checkout') {
                                steps {
                                      sh 'checkout scm'
                                       }
                                   }
                            stage('Build') {
                                steps {
                                 sh 'mvn clean package'
                                 }
                              }
                            stage('Test') {
                            steps {
                            sh 'mvn test'
                             }
                          }
                            stage('Archive') {
                            steps {
                         archiveArtifacts artifacts: '**/target/*.jar'
                         }
                       }
                   }
                }