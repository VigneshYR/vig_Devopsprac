        pipeline {
                agent any
                          stages {
                              stage('Checkout') {
                                steps {
                                checkout scm
                                       }
                                   }
                              stage('Build') {
                                steps {
                                  mvn clean package
                                 }
                              }
                              stage('Test') {
                                steps {
                                  mvn test
                                }
                              }
                              stage('Archive') {
                                steps {
                                  archiveArtifacts artifacts: '**/target/*.jar'
                                }
                              }
                          }
                      }